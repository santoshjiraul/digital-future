<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Santosh Kumar Yadav | Data Analyst</title>

  <meta name="description"
        content="Santosh Kumar Yadav - Data Analyst Portfolio | Python, SQL, Excel, Power BI, Tableau">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0b1120;
      color: #e5e7eb;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: 90%;
      max-width: 1150px;
      margin: auto;
    }

    /* NAVBAR */
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(11, 17, 32, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #1e293b;
    }

    .nav-container {
      height: 70px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
      color: #38bdf8;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      list-style: none;
    }

    .nav-links a {
      color: #cbd5e1;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: #38bdf8;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 70px;
      background:
        radial-gradient(circle at top right, #12385a 0, transparent 35%),
        radial-gradient(circle at bottom left, #10294a 0, transparent 35%);
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .small-title {
      color: #38bdf8;
      font-size: 18px;
      margin-bottom: 10px;
    }

    .hero h1 {
      font-size: clamp(45px, 7vw, 78px);
      line-height: 1.05;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: #38bdf8;
    }

    .hero h2 {
      font-size: 25px;
      color: #94a3b8;
      margin-bottom: 20px;
    }

    .hero p {
      max-width: 650px;
      color: #94a3b8;
      font-size: 17px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      margin-top: 30px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 13px 24px;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.3s;
      display: inline-block;
    }

    .primary {
      background: #38bdf8;
      color: #07111f;
    }

    .primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(56,189,248,0.25);
    }

    .secondary {
      border: 1px solid #334155;
      color: white;
    }

    .secondary:hover {
      border-color: #38bdf8;
      color: #38bdf8;
    }

    /* PROFILE CARD */
    .profile-card {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid #243244;
      padding: 35px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .profile-circle {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      margin: auto;
      background: linear-gradient(135deg, #38bdf8, #2563eb);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 55px;
      font-weight: bold;
      color: white;
    }

    .profile-card h3 {
      margin-top: 20px;
      font-size: 25px;
    }

    .profile-card p {
      color: #94a3b8;
    }

    /* SECTIONS */
    section {
      padding: 100px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title h2 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #94a3b8;
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .card {
      background: #111827;
      border: 1px solid #1f2937;
      padding: 30px;
      border-radius: 15px;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #38bdf8;
    }

    .card h3 {
      margin-bottom: 15px;
      color: #38bdf8;
    }

    .card p {
      color: #94a3b8;
    }

    /* SKILLS */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .skill {
      text-align: center;
      padding: 25px 15px;
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 12px;
      transition: 0.3s;
    }

    .skill:hover {
      transform: translateY(-5px);
      border-color: #38bdf8;
    }

    .skill .icon {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .skill h3 {
      margin-bottom: 5px;
    }

    .skill p {
      color: #94a3b8;
      font-size: 14px;
    }

    /* PROJECTS */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .project {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 15px;
      overflow: hidden;
      transition: 0.3s;
    }

    .project:hover {
      transform: translateY(-8px);
      border-color: #38bdf8;
    }

    .project-top {
      height: 130px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 55px;
      background: linear-gradient(135deg, #102a43, #172554);
    }

    .project-content {
      padding: 25px;
    }

    .project-content h3 {
      margin-bottom: 10px;
    }

    .project-content p {
      color: #94a3b8;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      background: #1e293b;
      color: #7dd3fc;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
    }

    /* CERTIFICATIONS */
    .cert-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .cert {
      background: #111827;
      border: 1px solid #1f2937;
      padding: 25px;
      border-radius: 12px;
    }

    .cert h3 {
      font-size: 18px;
      margin-bottom: 7px;
    }

    .cert p {
      color: #94a3b8;
    }

    /* DASHBOARD */
    .dashboard-box {
      background: #111827;
      border: 1px solid #1f2937;
      padding: 40px;
      border-radius: 20px;
      text-align: center;
    }

    .dashboard-box h3 {
      font-size: 27px;
      margin-bottom: 15px;
    }

    .dashboard-box p {
      color: #94a3b8;
      margin-bottom: 25px;
    }

    /* CONTACT */
    .contact-box {
      max-width: 750px;
      margin: auto;
      text-align: center;
      background: #111827;
      padding: 40px;
      border-radius: 20px;
      border: 1px solid #1f2937;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 25px;
    }

    .contact-link {
      padding: 12px 18px;
      border: 1px solid #334155;
      border-radius: 8px;
      transition: 0.3s;
    }

    .contact-link:hover {
      color: #38bdf8;
      border-color: #38bdf8;
    }

    /* FOOTER */
    footer {
      border-top: 1px solid #1e293b;
      padding: 30px 0;
      text-align: center;
      color: #64748b;
    }

    /* MOBILE */
    @media (max-width: 900px) {

      .nav-links {
        display: none;
      }

      .hero-content,
      .about-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid,
      .cert-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .projects-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        text-align: center;
      }

      .buttons {
        justify-content: center;
      }
    }

    @media (max-width: 500px) {

      .skills-grid,
      .cert-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 70px 0;
      }

      .profile-card {
        padding: 25px;
      }
    }
  </style>
</head>

